{
  "name": "xx121",
  "displayName": "XX121",
  "description": "A dark VS Code color theme inspired by CRT terminal interfaces",
  "version": "0.1.0",
  "publisher": "nathanmillwater",
  "author": {
    "name": "Nathan Millwater"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nathanmillwater/vsce-XX121"
  },
  "galleryBanner": {
    "color": "#06101a",
    "theme": "dark"
  },
  "keywords": [
    "theme",
    "dark",
    "crt",
    "retro",
    "terminal",
    "color-theme"
  ],
  "scripts": {
    "build": "node build-theme.js",
    "watch": "node -e \"const{watch}=require('fs');const{execSync}=require('child_process');watch('./src',{recursive:true},()=>{try{execSync('node build-theme.js',{stdio:'inherit'})}catch{}});console.log('Watching src/ for changes...')\"",
    "package": "npx @vscode/vsce package",
    "preversion": "node build-theme.js",
    "version": "git add themes/",
    "postversion": "git push --follow-tags",
    "release": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "XX121",
        "uiTheme": "vs-dark",
        "path": "./themes/XX121-color-theme.json"
      },
      {
        "label": "XX121 Yellow",
        "uiTheme": "vs-dark",
        "path": "./themes/XX121-yellow-color-theme.json"
      },
      {
        "label": "XX121 Green",
        "uiTheme": "vs-dark",
        "path": "./themes/XX121-green-color-theme.json"
      }
    ]
  }
}
